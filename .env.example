# Имена переменных окружения LUMOSCHOOL. Значений здесь нет и быть не должно (см. docs/SECRETS.md).
# Режим: prod | dev | test. Не задан — prod (строгие проверки).
LUMO_MODE=
# Серверный секрет сессий: случайная строка от 32 символов (в prod обязательна).
SESSION_SECRET=
# Путь к файлу базы SQLite (в prod обязателен, не :memory:).
DATABASE_PATH=
# Каталог резервных копий (для npm run backup).
BACKUP_DIR=
# Сколько копий хранить, 1..3650 (по умолчанию 14).
BACKUP_KEEP=
# Порт, 1..65535 (по умолчанию 8787); слушает только 127.0.0.1.
PORT=
# 1 — кука с флагом Secure (в prod обязательно, за HTTPS-прокси).
COOKIE_SECURE=
# Адреса доверенных прокси через запятую (например 127.0.0.1). Только от них читается X-Forwarded-For; пусто — заголовок игнорируется.
TRUSTED_PROXY=
# Срок хранения переписки, дней (по умолчанию в коде 730).
RETENTION_MESSAGE_DAYS=
# Срок хранения попыток входа, дней (по умолчанию в коде 90).
RETENTION_LOGIN_ATTEMPT_DAYS=
